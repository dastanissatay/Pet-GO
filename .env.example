# Copy to .env (git-ignored) and fill in. This file holds dummy values only.
# The repo is public: never commit a real key or password.

# "dev" or "prod". In prod the API docs are off.
ENV=dev
DEBUG=false

# Postgres container. docker compose builds the backend's DATABASE_URL from these.
POSTGRES_USER=petgo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=petgo
# Host port for the dev database (dev only; the port is closed in prod).
DB_PORT=5432

# Only needed when the backend runs outside docker compose (uv run on your machine,
# or a managed database such as Render). Inside compose this is set for you.
DATABASE_URL=postgresql+asyncpg://petgo:change-me@localhost:5432/petgo

# Comma-separated list of allowed browser origins. Required in prod.
CORS_ORIGINS=http://localhost:5173

# Anthropic key for the estimate decoder and receipt parser. Backend only.
# Leave empty to use the regex fallback.
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5

# Prod only: gunicorn workers and the port nginx is published on.
WEB_CONCURRENCY=2
HTTP_PORT=80

# Prod image only (backend/scripts/start.sh): port gunicorn binds to (hosts such as
# Render set it), and whether to apply migrations before starting. Leave
# RUN_MIGRATIONS=false where you run `make migrate` as a separate step.
PORT=8000
RUN_MIGRATIONS=false
